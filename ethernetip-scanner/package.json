{
  "name": "ethernetip-scanner",
  "version": "1.0.0",
  "description": "EtherNet/IP Device Scanner - finds Allen-Bradley PLCs, HMIs and other CIP devices on a plugged-in Ethernet port",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "mock": "node test/mock-device.js",
    "build": "electron-builder --win --x64",
    "build-installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.plantops.enipscanner",
    "productName": "EtherNet-IP Device Scanner",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EtherNet-IP Device Scanner"
    },
    "files": [
      "src/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "koffi": "^2.16.3"
  }
}
